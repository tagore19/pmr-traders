# ============================================================
# PMR Traders - Environment Configuration Example
# ============================================================

# Database (Production / Cloud: Render, Supabase, Neon, Railway)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Database (Alternative: Local PostgreSQL parameters)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pmr_traders
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSL=false

# Security
JWT_SECRET=your_super_secret_jwt_random_key_here

# Server
PORT=4000
NODE_ENV=production
AUTO_MIGRATE=true
CLIENT_URL=http://localhost:5173

